@startuml





package cards{
    package interfaces{
        interface Attacker {
            -m_attackPoints : Double
            +attack() : void
        }

        interface Flyable{

        }

        interface Drawable{

        }
    }

    class Card{
        -m_life : double
    }



    package obstacles{
        abstract class ObstacleCard extends cards.Card{}
        class Rock extends ObstacleCard{}
        class Pine extends ObstacleCard{}
    }
    package animals{

        abstract class AnimalCard extends cards.Card implements cards.interfaces.Attacker{
            -m_bloodDrops : Integer
            -m_bones : Integer
        }

        class Chat extends AnimalCard{}
        class Grizzly extends AnimalCard{}
        class Coyote extends AnimalCard{}
        class Moineau extends AnimalCard implements cards.interfaces.Flyable{}
        class Corbeau extends AnimalCard implements cards.interfaces.Flyable{}
        class Ecureuil extends AnimalCard{}
        class Hermine extends AnimalCard{}
        class Louveteau extends AnimalCard{}
        class Loup extends AnimalCard{}
        class Punaise extends AnimalCard{}
    }




    class Input{
    }

    package players{
        class Player{
        }
        class Rival{
        }

    }


    package display{

        class Score implements display.interfaces.Drawable{
        }
        class Draw{
        }

        class Display{
        }

        class Board implements display.interfaces.Drawable{
        }
    }
}
@enduml